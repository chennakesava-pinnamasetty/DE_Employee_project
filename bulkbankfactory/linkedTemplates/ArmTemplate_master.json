{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "bulkbankfactory"
		},
		"Is_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Is_adls'"
		},
		"Onprem_FileServer2_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Onprem_FileServer2'"
		},
		"onprem_fileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'onprem_fileServer1'"
		},
		"Is_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://bulkbankdataupload.dfs.core.windows.net/"
		},
		"Onprem_FileServer2_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\company_dataset"
		},
		"Onprem_FileServer2_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "PINNAMSETTY\\chenna"
		},
		"onprem_fileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Employees_data"
		},
		"onprem_fileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "PINNAMSETTY\\chenna"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "bulkbankfactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Is_adls_accountKey": {
						"value": "[parameters('Is_adls_accountKey')]"
					},
					"Onprem_FileServer2_password": {
						"value": "[parameters('Onprem_FileServer2_password')]"
					},
					"onprem_fileServer1_password": {
						"value": "[parameters('onprem_fileServer1_password')]"
					},
					"Is_adls_properties_typeProperties_url": {
						"value": "[parameters('Is_adls_properties_typeProperties_url')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"Onprem_FileServer2_properties_typeProperties_host": {
						"value": "[parameters('Onprem_FileServer2_properties_typeProperties_host')]"
					},
					"Onprem_FileServer2_properties_typeProperties_userId": {
						"value": "[parameters('Onprem_FileServer2_properties_typeProperties_userId')]"
					},
					"onprem_fileServer1_properties_typeProperties_host": {
						"value": "[parameters('onprem_fileServer1_properties_typeProperties_host')]"
					},
					"onprem_fileServer1_properties_typeProperties_userId": {
						"value": "[parameters('onprem_fileServer1_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}